{
  "name": "kingdoms-of-the-forgotten-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "smoke": "npx esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke/smoke.mjs --log-level=error && node .smoke/smoke.mjs",
    "longrun": "npx esbuild scripts/longrun.ts --bundle --platform=node --format=esm --outfile=.smoke/longrun.mjs --log-level=error && node .smoke/longrun.mjs",
    "memory": "npx esbuild scripts/memory-check.ts --bundle --platform=node --format=esm --outfile=.smoke/memory.mjs --log-level=error && node .smoke/memory.mjs",
    "standalone": "npm run build && node scripts/make-standalone.mjs",
    "studio": "node studio/bin/studio.mjs",
    "studio:validate": "node studio/bin/studio.mjs validate",
    "studio:gen": "node studio/bin/studio.mjs gen",
    "studio:test": "node --test studio/tests/"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
